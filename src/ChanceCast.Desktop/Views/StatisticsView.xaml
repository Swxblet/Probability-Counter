<UserControl x:Class="ChanceCast.Desktop.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChanceCast.App.ViewModels;assembly=ChanceCast.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,14,20,14" MaxWidth="560">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Actividad" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sesiones finalizadas:"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MatchesText}" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Intentos totales:"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalAttemptsText}" FontWeight="Bold"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Promedio por sesión:"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AverageText}" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Probabilidad" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Evento:"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EventNameText}" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tasa configurada:"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RateText}" FontWeight="Bold"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Probabilidad (historial):"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HistoryProbabilityText}" FontWeight="Bold"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Probabilidad (sesión actual):"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentProbabilityText}" FontWeight="Bold"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static vm:StatisticsViewModel.TheoreticalAverageLabel}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TheoreticalAverageText}" FontWeight="Bold"/>
                    </Grid>
                    <TextBlock Text="{x:Static vm:StatisticsViewModel.HistoryDisclaimer}"
                               Style="{StaticResource SecondaryTextStyle}" FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Proyecciones" Style="{StaticResource SectionTitleStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Objetivo" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Intentos" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Sesiones aprox." FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Targets[0].TargetText}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Targets[0].AttemptsText}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Targets[0].ProjectionText}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Targets[1].TargetText}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Targets[1].AttemptsText}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Targets[1].ProjectionText}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding Targets[2].TargetText}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Targets[2].AttemptsText}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Targets[2].ProjectionText}"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding Targets[3].TargetText}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Targets[3].AttemptsText}"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Targets[3].ProjectionText}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Static vm:StatisticsViewModel.IndependenceDisclaimer}"
                       Style="{StaticResource SecondaryTextStyle}" FontStyle="Italic"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
