<UserControl x:Class="ChanceCast.Desktop.Views.CounterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,16" HorizontalAlignment="Center" MaxWidth="420">
            <TextBlock Text="{Binding HasActiveMatch, Converter={StaticResource BoolToMatchStateConverter}}"
                       FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <TextBlock Text="{Binding Attempts}" FontSize="64" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,0"/>
            <TextBlock Text="intentos" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <Button Content="−1" Width="90" Height="44" FontSize="20" Margin="0,0,12,0"
                        Command="{Binding DecrementCommand}"/>
                <Button Content="+1" Width="90" Height="44" FontSize="20"
                        Command="{Binding IncrementCommand}"/>
            </StackPanel>

            <Button Content="Editar total" Width="200" Margin="0,0,0,8"
                    Command="{Binding EditCountCommand}"/>
            <Button Content="Iniciar sesión" Width="200" Margin="0,0,0,8"
                    Command="{Binding StartMatchCommand}"/>
            <Button Content="Terminar sesión" Width="200" Margin="0,0,0,4"
                    Command="{Binding FinishMatchCommand}"/>
            <Button Content="Descartar" Width="200" Style="{StaticResource LinkButtonStyle}"
                    Command="{Binding DiscardMatchCommand}"/>

            <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center">
                <Run Text="Probabilidad de la sesión: "/>
                <Run Text="{Binding MatchProbabilityText, Mode=OneWay}" FontWeight="Bold"/>
            </TextBlock>
            <TextBlock Text="Los atajos se configuran en Configuración."
                       FontStyle="Italic" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
