<UserControl x:Class="ChanceCast.Desktop.Views.CounterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,14,20,14" MaxWidth="440">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding HasActiveMatch, Converter={StaticResource BoolToMatchStateConverter}}"
                               Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Attempts}" Style="{StaticResource HeroNumberStyle}"/>
                    <TextBlock Text="intentos" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                    <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center">
                        <Run Text="Probabilidad de la sesión: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Run Text="{Binding MatchProbabilityText, Mode=OneWay}" FontWeight="Bold"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="−1  Restar" FontSize="20" Padding="0,12"
                        Command="{Binding DecrementCommand}"/>
                <Button Grid.Column="2" Content="+1  Sumar" FontSize="20" Padding="0,12"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding IncrementCommand}"/>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Button Content="&#xE70F;  Editar total" Margin="0,0,0,8"
                            Command="{Binding EditCountCommand}"/>
                    <Button Content="&#xE710;  Iniciar sesión" Margin="0,0,0,8"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartMatchCommand}"/>
                    <Button Content="Terminar sesión" Margin="0,0,0,4"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding FinishMatchCommand}"/>
                    <Button Content="Descartar sesión" Style="{StaticResource LinkButtonStyle}"
                            Foreground="{DynamicResource DangerBrush}"
                            Command="{Binding DiscardMatchCommand}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Los atajos se configuran en Configuración."
                       Style="{StaticResource SecondaryTextStyle}" FontStyle="Italic"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
