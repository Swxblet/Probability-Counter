<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta oscura -->
    <Color x:Key="BackgroundColor">#101014</Color>
    <Color x:Key="SurfaceColor">#17171D</Color>
    <Color x:Key="CardColor">#1F1F28</Color>
    <Color x:Key="BorderColor">#2E2E3B</Color>
    <Color x:Key="TextPrimaryColor">#F4F4F6</Color>
    <Color x:Key="TextSecondaryColor">#A7A7B8</Color>
    <Color x:Key="AccentColor">#10B981</Color>
    <Color x:Key="OnAccentColor">#052E22</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="InputBackgroundColor">#14141A</Color>
    <Color x:Key="DisabledColor">#6B6B7B</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}"/>

    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
</ResourceDictionary>
