<Window x:Class="ContadorCofres.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ContadorCofres.Desktop.Views"
        Title="Contador de Cofres" Height="640" Width="520" MinHeight="480" MinWidth="420"
        Topmost="{Binding AlwaysOnTop}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="12,8,12,4">
            <TextBlock Text="Contador de Cofres" FontWeight="Bold" FontSize="16"
                       VerticalAlignment="Center"/>
            <Button Content="Configuración" DockPanel.Dock="Right" Padding="12,4"
                    Command="{Binding OpenSettingsCommand}"/>
        </DockPanel>

        <TabControl Grid.Row="1" Margin="8,0,8,4">
            <TabItem Header="Contador">
                <views:CounterView DataContext="{Binding Counter}"/>
            </TabItem>
            <TabItem Header="Historial">
                <views:HistoryView DataContext="{Binding History}"/>
            </TabItem>
            <TabItem Header="Estadísticas">
                <views:StatisticsView DataContext="{Binding Statistics}"/>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding Status.Message}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
