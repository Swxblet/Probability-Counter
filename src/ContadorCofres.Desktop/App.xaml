<Application x:Class="ContadorCofres.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ContadorCofres.Desktop.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <views:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            <views:BoolToMatchStateConverter x:Key="BoolToMatchStateConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
