# Build SDK fijo para reproducibilidad entre WSL, Docker y CI.
FROM mcr.microsoft.com/dotnet/sdk:10.0.403

WORKDIR /src

# Copia primero los csproj para aprovechar la caché de restore.
COPY ChanceCast.slnx ./
COPY src/ChanceCast.Core/ChanceCast.Core.csproj src/ChanceCast.Core/
COPY src/ChanceCast.App/ChanceCast.App.csproj src/ChanceCast.App/
COPY tests/ChanceCast.Core.Tests/ChanceCast.Core.Tests.csproj tests/ChanceCast.Core.Tests/
COPY tests/ChanceCast.Desktop.Tests/ChanceCast.Desktop.Tests.csproj tests/ChanceCast.Desktop.Tests/

RUN dotnet restore tests/ChanceCast.Core.Tests/ChanceCast.Core.Tests.csproj \
 && dotnet restore tests/ChanceCast.Desktop.Tests/ChanceCast.Desktop.Tests.csproj

COPY . .

# Solo proyectos testeables en Linux: Core y App (nada de WPF).
CMD ["sh", "-c", "dotnet test tests/ChanceCast.Core.Tests/ChanceCast.Core.Tests.csproj --nologo -v q && dotnet test tests/ChanceCast.Desktop.Tests/ChanceCast.Desktop.Tests.csproj --nologo -v q"]
